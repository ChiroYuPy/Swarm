{
  "name": "swarm",
  "private": true,
  "version": "0.12.0",
  "description": "SWARM: a deterministic neon survivor-like (TypeScript + Vite).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.sim.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "balance": "tsx scripts/balance.ts",
    "golden:update": "tsx scripts/update-golden.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0"
  }
}
